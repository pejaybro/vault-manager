{
  "expo": {
    "name": "Vault Manager",
    "slug": "vault-manager",
    "scheme": "vaultmanager",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#0F0F12",
      "resizeMode": "contain",
      "image": "./assets/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-splash-screen",
      "./plugins/withAndroidAutofillService"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vaultmanager.app",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Vault Manager uses Face ID to securely unlock your encrypted vault."
      }
    },
    "android": {
      "package": "com.vaultmanager.app",
      "compileSdkVersion": 34,
      "targetSdkVersion": 34,
      "buildToolsVersion": "34.0.0",
      "adaptiveIcon": {
        "backgroundColor": "#0F0F12",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "CAMERA"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b2768596-3e98-4816-8a42-278894ba6a76"
      }
    }
  }
}
