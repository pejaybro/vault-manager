{
  "manifest_version": 3,
  "name": "Vault Manager — Password & 2FA Auto-Fill",
  "version": "1.0.0",
  "description": "Offline-first password manager, 2FA authenticator, and digital key auto-fill for Chrome, Edge, Firefox, Brave, and Safari.",
  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "Vault Manager"
  },
  "background": {
    "service_worker": "src/background.ts"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content.ts"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "clipboardWrite"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
